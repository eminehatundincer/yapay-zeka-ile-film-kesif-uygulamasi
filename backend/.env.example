# Gemini API Key (Google AI Studio üzerinden temin edebilirsiniz: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL Veritabanı Bağlantısı (AsyncPG)
# Yerel geliştirme için varsayılan PostgreSQL bağlantı adresi
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/film_kesif_db

# OMDb API Key (IMDb puanı, IMDb ID ve HD film afişleri için: https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your-omdb-api-key-here

# TMDB API Key veya Read Access Token (Türkçe özet, HD afiş ve toplu katalog için: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key-here
